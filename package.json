{
  "name": "sanchez-pattern",
  "version": "0.1.0",
  "description": "A browser-based generative pattern creator with reusable SVG shape libraries.",
  "private": true,
  "author": "Mikołaj Grabowski (Nick Sanchez)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "ai:check": "node scripts/check-ai-skills.mjs",
    "dev": "node scripts/run-vite-on-free-port.mjs dev",
    "dev:restart": "node scripts/run-vite-on-free-port.mjs dev --toolcraft-restart",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "docs:screenshot": "node scripts/capture-readme-screenshot.mjs",
    "preview": "node scripts/run-vite-on-free-port.mjs preview",
    "preview:restart": "node scripts/run-vite-on-free-port.mjs preview --toolcraft-restart",
    "docs:check": "node scripts/check-toolcraft-docs.mjs",
    "test": "node scripts/check-toolcraft-docs.mjs && node scripts/check-toolcraft-integrity.mjs && node --test scripts/*.test.mjs && vitest run src --passWithNoTests",
    "test:browser": "playwright install chromium && playwright test --grep-invert \"browser perf:\"",
    "test:browser:perf": "playwright install chromium && playwright test --grep \"browser perf:\" --workers=1 --pass-with-no-tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:quick": "npm run ai:check && npm run test",
    "verify:ui": "npm run test:browser",
    "verify:perf": "npm run test:browser:perf",
    "verify:perf:playwright": "npm run test:browser:perf",
    "verify:final": "npm run ai:check && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
